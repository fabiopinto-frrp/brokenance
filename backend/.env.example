# Every variable the API uses. This file IS committed, so it never contains real secrets.
# Copy it to .env (not committed) and fill in the empty values:
#   cp .env.example .env

NODE_ENV=development
PORT=3000

# Postgres. docker compose uses these to create the database.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Connection string, for example postgres://user:password@localhost:5432/brokenance
# Inside docker compose the host is replaced by `db` automatically.
DATABASE_URL=

# Auth. Use a long random value (at least 32 characters): openssl rand -hex 32
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Set to false once your account exists.
REGISTRATION_ENABLED=true

# Interactive API documentation at /docs and the OpenAPI file at /openapi.json.
# Consider false in production.
DOCS_ENABLED=true

# CORS only affects browsers (for example Flutter web with `flutter run -d chrome`).
# The Android and iOS app are not subject to it.
# Development: * allows any origin. Production: a comma-separated list of exact origins,
# for example https://app.example.com,https://admin.example.com
CORS_ORIGIN=*
