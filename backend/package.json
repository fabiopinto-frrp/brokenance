{
  "name": "brokenance-backend",
  "version": "1.0.0",
  "description": "Brokenance REST API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
