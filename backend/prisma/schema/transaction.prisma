enum TransactionType {
  EXPENSE
  OUTING
  LEISURE
  INCOME
  SUBSCRIPTION_CHARGE
  ADJUSTMENT

  @@map("transaction_type")
}

// Everything that changes net worth.
//
// Recurring transactions (monthly income, subscription charges) are generated by the backend and
// carry a `recurringKey`. The unique constraint on (userId, recurringKey) makes it impossible
// to apply the same period twice, even if two requests run at the same time.
//   income:        "income:2026-10"
//   subscription:  "subscription:<subscriptionId>:2026-10" (monthly) or ":2026" (yearly)
model Transaction {
  id             String          @id @default(uuid(7)) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  type           TransactionType
  name           String
  // Signed: expenses, outings, leisure and subscription charges are negative.
  amountCents    Int             @map("amount_cents")
  date           DateTime        @db.Date
  note           String?
  subscriptionId String?         @map("subscription_id") @db.Uuid
  // Set only on automatic transactions.
  recurringKey   String?         @map("recurring_key")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([userId, recurringKey])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([subscriptionId])
  @@map("transactions")
}
